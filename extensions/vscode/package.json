{
  "name": "phantomdep",
  "displayName": "PhantomDep",
  "description": "Local-first dependency firewall for AI coding agents. Catches hallucinated, squatted, and malicious packages before they reach your repo.",
  "version": "1.0.0",
  "publisher": "openintelligence-labs",
  "license": "MIT",
  "homepage": "https://github.com/openintelligence-labs/phantomdep",
  "repository": {
    "type": "git",
    "url": "https://github.com/openintelligence-labs/phantomdep.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/openintelligence-labs/phantomdep/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "supply-chain",
    "ai",
    "slopsquatting",
    "dependency",
    "phantom",
    "firewall",
    "claude",
    "cursor"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "PhantomDep",
      "properties": {
        "phantomdep.binaryPath": {
          "type": "string",
          "default": "phantomdep",
          "description": "Path to the phantomdep binary. Defaults to `phantomdep` on $PATH."
        },
        "phantomdep.phantomDbPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a phantom-db directory. If unset, the binary's bootstrap dataset is used."
        },
        "phantomdep.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication between VS Code and phantomdep."
        }
      }
    },
    "commands": [
      {
        "command": "phantomdep.restartServer",
        "title": "PhantomDep: Restart Language Server"
      },
      {
        "command": "phantomdep.runDoctor",
        "title": "PhantomDep: Run Doctor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
